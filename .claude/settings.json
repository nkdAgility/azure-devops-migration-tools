{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.specify/events.py\" speckit.engineering-checks.guard pre_tool_use 30",
            "timeout": 35,
            "__speckit_event__": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.specify/events.py\" speckit.engineering-checks.auto-advance post_tool_use 60",
            "timeout": 65,
            "__speckit_event__": true,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "PowerShell(gh *)",
      "PowerShell(az *)",
      "Bash(gh *)",
      "Bash(az *)",
      "PowerShell(pwsh *.specify/extensions/engineering-checks/scripts/publish-item-docs.ps1*)",
      "Edit(specs/**)",
      "Edit(.specify/bugs/**)",
      "Edit(.specify/assessments/**)",
      "Edit(.specify/reviews/**)",
      "Edit(.specify/items/**)",
      "Edit(.specify/wkr/**)"
    ]
  },
  "enabledPlugins": {
    "nkda-engineering-delivery@nkda-engineering": false
  }
}
