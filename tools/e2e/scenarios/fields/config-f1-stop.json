{
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "MigrationTools": {
    "Version": "16.0",
    "Endpoints": {
      "Source": {
        "EndpointType": "TfsTeamProjectEndpoint",
        "Collection": "https://dev.azure.com/nkdagility-adomt-source/",
        "Project": "amte2e-fields-src",
        "ReflectedWorkItemIdField": "Custom.ReflectedWorkItemId",
        "AllowCrossProjectLinking": false,
        "Authentication": {
          "AuthenticationMode": "EntraId"
        },
        "LanguageMaps": {
          "AreaPath": "Area",
          "IterationPath": "Iteration"
        }
      },
      "Target": {
        "EndpointType": "TfsTeamProjectEndpoint",
        "Collection": "https://dev.azure.com/nkdagility-adomt-target/",
        "Project": "amte2e-fields-tgt",
        "ReflectedWorkItemIdField": "Custom.ReflectedWorkItemId",
        "AllowCrossProjectLinking": false,
        "Authentication": {
          "AuthenticationMode": "EntraId"
        },
        "LanguageMaps": {
          "AreaPath": "Area",
          "IterationPath": "Iteration"
        }
      }
    },
    "CommonTools": {
      "TfsNodeStructureTool": {
        "Enabled": true,
        "Areas": {
          "Mappings": [
            {
              "Match": "^amte2e-fields-src([\\\\]?.*)$",
              "Replacement": "amte2e-fields-tgt$1"
            },
            {
              "Match": "^amte2e-fields-old([\\\\]?.*)$",
              "Replacement": "amte2e-fields-tgt$1"
            }
          ],
          "Filters": []
        },
        "Iterations": {
          "Mappings": [
            {
              "Match": "^amte2e-fields-src([\\\\]?.*)$",
              "Replacement": "amte2e-fields-tgt$1"
            },
            {
              "Match": "^amte2e-fields-old([\\\\]?.*)$",
              "Replacement": "amte2e-fields-tgt$1"
            }
          ],
          "Filters": []
        },
        "ShouldCreateMissingRevisionPaths": true,
        "ReplicateAllExistingNodes": true
      },
      "TfsRevisionManagerTool": {
        "Enabled": true,
        "MaxRevisions": 0,
        "ReplayRevisions": true
      },
      "TfsAttachmentTool": {
        "Enabled": true,
        "MaxAttachmentSize": 480000000,
        "ExportBasePath": "c:\\temp\\amte2e-attachments"
      },
      "TfsWorkItemLinkTool": {
        "Enabled": true,
        "FilterIfLinkCountMatches": true,
        "SaveAfterEachLinkIsAdded": false
      },
      "TfsUserMappingTool": {
        "Enabled": false
      },
      "TfsTeamSettingsTool": {
        "Enabled": false
      },
      "TfsWorkItemTypeValidatorTool": {
        "Enabled": true,
        "ScanRevisionHistoryForFields": true,
        "StopIfHistoryOnlyFieldsFound": true,
        "ExcludeSourceFields": {
          "Issue": [
            "Microsoft.VSTS.Scheduling.DueDate",
            "Microsoft.VSTS.Scheduling.StoryPoints",
            "System.Reason"
          ]
        }
      },
      "FieldMappingTool": {
        "FieldMaps": [
          {
            "FieldMapType": "FieldtoFieldMap",
            "sourceField": "Custom.amte2eIssueOnly",
            "ApplyTo": [
              "Issue"
            ],
            "targetField": "Microsoft.VSTS.Build.IntegrationBuild"
          },
          {
            "FieldMapType": "FieldtoFieldMap",
            "sourceField": "Custom.ReflectedWorkItemId",
            "fieldMapMode": "TargetToTarget",
            "ApplyTo": [
              "Task"
            ],
            "targetField": "System.Description"
          }
        ],
        "Enabled": true
      },
      "WorkItemTypeMappingTool": {
        "Mappings": {
          "Issue": "Task"
        },
        "Enabled": true
      }
    },
    "Processors": [
      {
        "ProcessorType": "TfsWorkItemMigrationProcessor",
        "Enabled": true,
        "SourceName": "Source",
        "TargetName": "Target",
        "UpdateCreatedDate": true,
        "UpdateCreatedBy": true,
        "WIQLQuery": "SELECT [System.Id] FROM WorkItems WHERE [System.TeamProject] = @TeamProject AND [System.WorkItemType] NOT IN ('Test Suite', 'Test Plan','Shared Steps','Shared Parameter','Feedback Request') ORDER BY [System.Id]",
        "FixHtmlAttachmentLinks": false,
        "WorkItemCreateRetryLimit": 5,
        "FilterWorkItemsThatAlreadyExistInTarget": false,
        "GenerateMigrationComment": true,
        "MaxGracefulFailures": 0,
        "SkipRevisionWithInvalidIterationPath": false,
        "SkipRevisionWithInvalidAreaPath": false
      }
    ]
  }
}
